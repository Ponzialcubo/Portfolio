# ── SergioLab Portfolio — variables de entorno ────────────────────────────────
# Copia este archivo como .env.local para desarrollo.
# En Vercel añádelas en: Project → Settings → Environment Variables.
# NUNCA subas .env.local a git (ya está en .gitignore).

# ── Formulario de contacto (Resend) ──────────────────────────────────────────
# API key del proyecto "SergioLab Portfolio" en Resend (dash.resend.com/api-keys).
# Se usa en la serverless function api/contact.js — SOLO en Vercel, no en Vite.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email destinatario del formulario de contacto (por defecto: info@sergiolab.es).
CONTACT_EMAIL=info@sergiolab.es

# Origen permitido para CORS (por defecto: https://sergiolab.es).
ALLOWED_ORIGIN=https://sergiolab.es

# Endpoint del formulario de contacto. En desarrollo puedes dejarlo vacío
# (usará /api/contact relativo). En producción con dominio separado, ponlo aquí.
# VITE_CONTACT_ENDPOINT=https://sergiolab.es/api/contact

# ── Chat IA (FloatingChat + FAQ) ─────────────────────────────────────────────
# API key de Anthropic para el proxy de Claude (api/chat.js en Vercel).
# Se obtiene en: console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Endpoint del chat IA. En Vercel es relativo (/api/chat).
# Solo necesitas cambiarlo si usas un origen externo (ej. Cloudflare Worker).
VITE_CHAT_ENDPOINT=/api/chat
