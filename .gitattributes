# Normaliza finales de línea: LF en el repo para todo el texto.
# Evita que clones en Windows reintroduzcan CRLF y ensucien diffs.
* text=auto eol=lf

# Scripts shell SIEMPRE LF (si no, no arrancan en Linux).
*.sh text eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.mp4 binary
